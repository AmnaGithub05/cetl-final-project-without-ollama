# Gemini API Configuration
# Get your API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Ollama Configuration (optional, for misconception detection)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT=60

# MicroCheck Database
MICROCHECK_DB_PATH=microcheck.db
MICROCHECK_SECRET_KEY=your-secret-key-here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1
